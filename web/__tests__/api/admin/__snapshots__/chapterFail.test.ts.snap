// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DELETE /api/admin/chapters-failed/:serviceId/:chapterIdentifier > returns 400 with invalid serviceId "-1" 1`] = `"Too small: expected number to be >=0"`;

