{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^26|^24",
    "pnpm": "^12"
  },
  "imports": {
    "#server/*": "./server/*.js",
    "#components/*": "./src/components/*.js",
    "#web/*": "./src/*.js",
    "#webUtils/*": [
      "./src/utils/*.js"
    ],
    "#common/*": [
      "./common/*.js"
    ]
  },
  "scripts": {
    "start-dev": "node --enable-source-maps -r dotenv/config dist/server.js",
    "dev": "vite dev",
    "start-coverage": "node --enable-source-maps instrumented/server.js",
    "start-coverage-dev": "nyc node --enable-source-maps -r dotenv/config instrumented/server.js",
    "build": "cross-env IS_PRERENDER=1 vite build && pnpm build-server",
    "build-server": "tsc --project tsconfig.server.json && tsx scripts/rolldown.server.ts",
    "server-dev": "tsx watch --include \"./server/**/*\" --env-file=.env server.ts",
    "deploy": "pnpm start",
    "analyze": "cross-env ANALYZE=true vite build",
    "test": "vitest run",
    "tsc": "tsc --project tsconfig.json && tsc --project tsconfig.server.json && tsc --project __tests__/tsconfig.json && tsc --project cypress/tsconfig.json",
    "tsc:ui": "tsc --project tsconfig.json",
    "tsc:server": "tsc --project tsconfig.server.json",
    "tsc:tests": "tsc --project __tests__/tsconfig.json",
    "tsc:cypress": "tsc --project cypress/tsconfig.json",
    "test:ci": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "lint": "eslint -c eslint.config.mjs --concurrency auto --cache .",
    "lint:fix": "eslint -c eslint.config.mjs --fix .",
    "cypress": "cd cypress && pnpm run tsc && pnpm run cypress",
    "build-nyc": "pnpm build && tsx scripts/copy-dist-for-nyc.ts && nyc instrument --nycrc-path .nycrc.server.yaml dist instrumented"
  },
  "sideEffects": false,
  "browserslist": {
    "production": [
      "defaults"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@elastic/elasticsearch": "~7.17.14",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-date-pickers": "9.13.0",
    "@slonik/pg-driver": "^49.11.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/table-core": "^9.3.1",
    "@uiw/react-codemirror": "4.25.8",
    "arctic": "^3.7.0",
    "camelcase-keys": "^10.0.3",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.52.0",
    "express": "^5.3.0",
    "frappe-charts": "^1.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "iso8601-duration": "^2.2.0",
    "ky": "^2.2.0",
    "lru-cache": "^11.5.3",
    "mangadex-full-api": "^6.2.0",
    "material-ui-confirm": "^4.0.0",
    "notistack": "^3.0.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "postgres-interval": "^4.1.0",
    "rate-limiter-flexible": "^11.2.3",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-frappe-charts": "^4.1.0",
    "react-hook-form": "^7.90.0",
    "react-hook-form-mui": "^9.0.1",
    "react-intersection-observer": "^11.0.1",
    "rss": "github:s0hv/node-rss#semver:1.3.0",
    "slonik": "^49.11.0",
    "snakecase-keys": "^9.0.2",
    "srvx": "^1.0.6",
    "swagger-jsdoc": "^6.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@elastic/elasticsearch-mock": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@hookform/devtools": "^4.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/cookiejar": "^2.1.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-table": "^7.7.20",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "cookie": "^2.0.1",
    "cookie-signature": "^1.2.2",
    "cookiejar": "^2.1.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-import-zod": "^1.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fetch-mock": "^9.11.0",
    "globals": "^17.13.0",
    "happy-dom": "20.14.3",
    "jest-extended": "^7.0.0",
    "jest-openapi": "^0.14.2",
    "json-schema-faker": "^0.6.3",
    "msw": "^2.15.0",
    "node-fetch": "^3.3.2",
    "nyc": "^18.0.0",
    "rolldown": "^1.2.14",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "undici": "^8.12.3",
    "vite": "^8.3.4",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.5",
    "zod-compiler": "^2.0.7"
  },
  "packageManager": "pnpm@12.6.0"
}
