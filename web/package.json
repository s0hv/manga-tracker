{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^24",
    "pnpm": "^10"
  },
  "imports": {
    "#server/*": "./server/*.js",
    "#components/*": "./src/components/*.js",
    "#web/*": "./src/*.js",
    "#webUtils/*": [
      "./src/utils/*.js"
    ],
    "#common/*": [
      "./common/*.js"
    ]
  },
  "scripts": {
    "start-dev": "node --enable-source-maps -r dotenv/config dist/server.js",
    "dev": "vite dev",
    "start-coverage": "node --enable-source-maps instrumented/server.js",
    "start-coverage-dev": "nyc node --enable-source-maps -r dotenv/config instrumented/server.js",
    "build": "cross-env IS_PRERENDER=1 vite build && pnpm build-server",
    "build-server": "tsc --project tsconfig.server.json && tsx scripts/rolldown.server.ts",
    "server-dev": "tsx watch --include \"./server/**/*\" --env-file=.env server.ts",
    "deploy": "pnpm start",
    "analyze": "cross-env ANALYZE=true vite build",
    "test": "vitest run",
    "tsc": "tsc --project tsconfig.json && tsc --project tsconfig.server.json && tsc --project __tests__/tsconfig.json && tsc --project cypress/tsconfig.json",
    "test:ci": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "lint": "eslint -c eslint.config.mjs --concurrency 4 .",
    "lint:fix": "eslint -c eslint.config.mjs --fix .",
    "cypress": "cd cypress && pnpm run tsc && pnpm run cypress",
    "build-nyc": "pnpm build && tsx scripts/copy-dist-for-nyc.ts && nyc instrument --nycrc-path .nycrc.server.yaml dist instrumented"
  },
  "sideEffects": false,
  "browserslist": {
    "production": [
      "defaults"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@elastic/elasticsearch": "~7.17.14",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.7.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/system": "^9.3.0",
    "@mui/x-date-pickers": "9.11.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.21",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.38",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/table-core": "^9.1.2",
    "@uiw/react-codemirror": "4.25.8",
    "arctic": "^3.7.0",
    "camelcase-keys": "^10.0.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "es-toolkit": "^1.50.0",
    "express": "^5.2.1",
    "frappe-charts": "^1.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "iso8601-duration": "^2.1.4",
    "ky": "^2.0.2",
    "lru-cache": "^11.5.2",
    "mangadex-full-api": "^6.2.0",
    "material-ui-confirm": "^4.0.0",
    "notistack": "^3.0.2",
    "pg-error-constants": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "3.4.9",
    "postgres-interval": "^4.1.0",
    "rate-limiter-flexible": "^10.0.1",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-frappe-charts": "^4.1.0",
    "react-hook-form": "^7.84.0",
    "react-hook-form-mui": "^9.0.1",
    "rss": "github:s0hv/node-rss#semver:1.3.0",
    "snakecase-keys": "^9.0.2",
    "srvx": "^0.12.5",
    "swagger-jsdoc": "^6.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@elastic/elasticsearch-mock": "^1.0.0",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.5.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@hookform/devtools": "^4.4.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/cookiejar": "^2.1.5",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.13.3",
    "@types/prop-types": "^15.7.15",
    "@types/random-seed": "^0.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-table": "^7.7.20",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "cookie": "^1.1.1",
    "cookie-signature": "^1.2.2",
    "cookiejar": "^2.1.4",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-zod": "^1.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fetch-mock": "^9.11.0",
    "globals": "^17.9.0",
    "jest-extended": "^7.0.0",
    "jest-openapi": "^0.14.2",
    "jsdom": "^29.1.1",
    "json-schema-faker": "^0.6.3",
