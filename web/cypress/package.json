    "cypress": "15.20.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress"
    ]
  },
  "nyc": {
    "excludeAfterRemap": false,
