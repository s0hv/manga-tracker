  "engines": {
    "node": "^26|^24",
    "pnpm": "^12"
  },
  "imports": {
    "#server/*": "./dist/server/*.js"
  },
  "scripts": {
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "tsc": "tsc --project tsconfig.server.json && tsc-alias --project tsconfig.server.json"
