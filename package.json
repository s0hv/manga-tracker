{
  "name": "install-script",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^26",
    "pnpm": "^12"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  },
  "scripts": {
    "deploy": "cd web && pnpm run deploy",
    "server-dev": "cd web && pnpm server-dev",
    "create-migration": "node scripts/migrate.mjs create",
    "create-migration:test": "node scripts/migrate.mjs create --test",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:test": "node scripts/migrate.mjs up --test --test-db",
    "migrate:up:test": "node scripts/migrate.mjs up --test-db && pnpm migrate:test",
    "migrate:reset:test": "node scripts/migrate.mjs down --test --test-db && pnpm migrate:up:test",
    "migrate:down": "node scripts/migrate.mjs down"
  },
  "cacheDirectories": [
    "node_modules/"
  ],
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
